    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saip-coditation/TerraSketch.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/saip-coditation/TerraSketch/tree/main/mcp-server#readme",
  "bugs": "https://github.com/saip-coditation/TerraSketch/issues",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
