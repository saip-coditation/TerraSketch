# Leave empty for local dev + Vite proxy (/api → FastAPI). Best for ngrok (one tunnel to port 5173).
# Or set a full API URL, e.g. http://localhost:8000 or http://192.168.1.42:8000
VITE_API_URL=

# Google OAuth Client ID — enables "Sign in with Google" on the account page.
# Get one at https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Leave empty to disable Google sign-in (email/password auth still works).
VITE_GOOGLE_CLIENT_ID=
