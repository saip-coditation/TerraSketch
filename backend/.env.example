# --- LLM provider: anthropic | gemini | azure | mock ---
LLM_PROVIDER=azure
LLM_FALLBACK_PROVIDER=mock

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Max completion tokens (larger = less truncation for big Terraform JSON). Respect model/API limits.
ANTHROPIC_MAX_TOKENS=16384

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Azure OpenAI — MUST be the resource endpoint from Azure Portal (Keys and Endpoint),
# NOT the Foundry project URL. Example: https://YOUR_RESOURCE_NAME.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com
AZURE_OPENAI_API_KEY=
# Deployment name only (as shown in Azure OpenAI → Deployments), e.g. gpt-4o
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MAX_TOKENS=16384

DATABASE_URL=sqlite:///./terrasketch.db
# Comma-separated. In development, private LAN origins (192.168.x.x, etc.) are also allowed via regex.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
# Set false in production if you only want ALLOWED_ORIGINS (no regex).
CORS_ALLOW_PRIVATE_NETWORK=true
RATE_LIMIT_GENERATE=5/minute
# Skip terraform init/validate subprocess after each generate (faster local dev)
SKIP_TERRAFORM_VALIDATE=false

APP_NAME=TerraSketch
APP_ENV=development
LOG_LEVEL=INFO

# JWT for /api/auth/* — use a long random string in production
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=10080
RATE_LIMIT_AUTH=20/minute

# Optional: Django-like DB admin UI at http://localhost:8000/admin (SQLAdmin)
# ADMIN_UI_USER=admin
# ADMIN_UI_PASSWORD=choose-a-strong-password
# ADMIN_SESSION_SECRET=  # optional; defaults to JWT_SECRET
