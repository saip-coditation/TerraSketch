# Copy to .env and adjust. See README for full setup.

APP_ENV=development

ANTHROPIC_API_KEY=

# SQLAdmin at http://127.0.0.1:8000/admin — in development, if unset, defaults to
# user admin / password terrasketch-dev-admin (see app.core.config).
ADMIN_UI_USER=admin
ADMIN_UI_PASSWORD=
ADMIN_UI_ENABLED=true
ADMIN_SESSION_SECRET=

JWT_SECRET=change-me-in-production-use-a-long-random-string

# Google OAuth — enables POST /api/auth/google. Get a Client ID from:
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=

DATABASE_URL=sqlite:///./terrasketch.db

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
