# Anthropic Claude API key (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Anthropic model to use (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Gemini (optional) — free-tier friendly provider option
GEMINI_API_KEY=AIzaSyDBosBf4oevQO0umAwVORY5y2ExRynfAcM
GEMINI_MODEL=gemini-2.0-flash

# LLM provider selection: anthropic | gemini | mock
LLM_PROVIDER=gemini

# If selected provider fails with quota/credit exhaustion:
# set to "mock" for zero-cost fallback output.
LLM_FALLBACK_PROVIDER=mock

# Database connection (PostgreSQL on Render in production, SQLite locally)
# Example Postgres: postgresql+psycopg2://user:pass@host:5432/dbname
# For local dev you can use SQLite: sqlite:///./terrasketch.db
DATABASE_URL=sqlite:///./terrasketch.db

# CORS — comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (per IP) — used by slowapi
RATE_LIMIT_GENERATE=5/minute

# App settings
APP_NAME=TerraSketch
APP_ENV=development
LOG_LEVEL=INFO
